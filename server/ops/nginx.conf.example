# Install under /etc/nginx/conf.d/studyhub.conf after replacing the hostname
# and certificate paths. Requires an actual domain and trusted certificate.
limit_req_zone $binary_remote_addr zone=studyhub_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=studyhub_login:10m rate=10r/m;
server {
    listen 80;
    listen [::]:80;
    server_name studyhub.example.invalid;
    return 308 https://studyhub.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name studyhub.example.invalid;
    ssl_certificate /etc/letsencrypt/live/studyhub.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studyhub.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 256k;
    client_body_timeout 15s;
    access_log off;
    error_log /var/log/nginx/studyhub-error.log warn;
    limit_req_status 429;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    location = /api/v1/auth/max {
        limit_req zone=studyhub_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location /api/ {
        limit_req zone=studyhub_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location ~ ^/(docs|redoc|openapi\.json)(/|$) { return 404; }
    location = /cabinet { return 308 /cabinet/; }
    location / { proxy_pass http://127.0.0.1:8000; }
}
